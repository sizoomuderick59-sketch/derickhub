# MAIZE AI ADVISOR Environment Configuration

# Flask Application Settings
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DEBUG=True

# Database Configuration (SQLite default; PostgreSQL/MySQL supported)
# Examples:
# SQLite: sqlite:///instance/maize_advisor.db
# PostgreSQL: postgresql://postgres:password@localhost:5432/maize_advisor
# MySQL: mysql+pymysql://root:password@localhost:3306/maize_advisor
DATABASE_URL=sqlite:///instance/maize_advisor.db

# Machine Learning & Computer Vision
MODEL_PATH=data/models/maize_model_v1.pth
MODEL_VERSION=maize-mobilenet-v1.0
CONFIDENCE_THRESHOLD=0.70
DEVICE=cpu

# AI Advisory & RAG Engine Configuration
# Supported providers: expert (offline rule/knowledge engine), openai, ollama
LLM_PROVIDER=expert
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama Local LLM Configuration (if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# File Upload Settings
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=app/static/uploads/diagnoses

# Default Admin Credentials for initial database seed
ADMIN_EMAIL=admin@maizeai.org
ADMIN_PASSWORD=AdminSecurePassword123!
ADMIN_NAME=System Administrator

# Password recovery email (SMTP with STARTTLS)
PUBLIC_BASE_URL=http://127.0.0.1:5000
PASSWORD_RESET_MAX_AGE=3600
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
